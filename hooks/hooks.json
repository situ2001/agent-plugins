{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/avoid-speculative-defensiveness.md\"",
            "statusMessage": "loading coding guidance"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/check-rg-footgun.py\"",
            "timeout": 10,
            "statusMessage": "checking rg -r footgun"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/check-deletion-scope.py\"",
            "timeout": 10,
            "statusMessage": "checking deletion command and scope"
          }
        ]
      }
    ]
  }
}
